.Set CabinetNameTemplate=makecab_mszip.cab
.Set DiskDirectoryTemplate=C:\OUT
.Set Cabinet=on
.Set Compress=on
.Set CompressionType=MSZIP
.Set MaxDiskSize=0
.Set RptFileName=C:\OUT\mszip.rpt
.Set InfFileName=C:\OUT\mszip.inf
"C:\C\hello world.txt" "hello world.txt"
.Set DestinationDir=folder
"C:\C\folder\README.md" "README.md"
"C:\C\folder\NestedArchive.zip" "NestedArchive.zip"
