.Set CabinetNameTemplate=makecab_lzx21.cab
.Set DiskDirectoryTemplate=C:\OUT
.Set Cabinet=on
.Set Compress=on
.Set CompressionType=LZX
.Set CompressionMemory=21
.Set MaxDiskSize=0
.Set RptFileName=C:\OUT\lzx21.rpt
.Set InfFileName=C:\OUT\lzx21.inf
"C:\C\hello world.txt" "hello world.txt"
.Set DestinationDir=folder
"C:\C\folder\README.md" "README.md"
"C:\C\folder\NestedArchive.zip" "NestedArchive.zip"
